PROJECT_NAME="Enterprise CRM API"
API_V1_STR="/api/v1"
SECRET_KEY="crm-super-secret-key-2026-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_ABSOLUTE_EXPIRE_DAYS=30
JWT_ISSUER=enterprise-crm
JWT_AUDIENCE=enterprise-crm-api

# Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crm_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/crm_db

# Redis & Celery Configuration
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AWS S3 File Storage
AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=crm-enterprise-bucket
AWS_REGION=us-east-1

# SMTP / Email
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=you@example.com
EMAILS_FROM_PASSWORD=
EMAILS_FROM_NAME="Enterprise CRM Support"
RESET_TOKEN_EXPIRE_MINUTES=60
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
RESEND_API_KEY=

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=

# AI Integration Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
SUSANOOX_AI_KEY=your-susanoox-api-key
AI_PROVIDER=susanoox
AI_MODEL=susanoox-fast
SUSANOOX_MODEL_POOL=susanoox-fast,susanoox-large
AI_WEB_SEARCH_MODEL=gpt-4.1-mini
AI_TRANSCRIPTION_MODEL=whisper-1
AI_MAX_RETRIES=0
# Optional Gemini-specific models. When blank, Gemini uses AI_MODEL.
AI_GEMINI_WEB_SEARCH_MODEL=
AI_GEMINI_TRANSCRIPTION_MODEL=
AI_GEMINI_FALLBACK_MODEL=

# Environment & CORS
ENVIRONMENT=development
CORS_ORIGINS=https://crm-one-sable.vercel.app,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=https://crm-one-sable.vercel.app,http://localhost:3000

# Third-party OAuth integrations (server-side only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
